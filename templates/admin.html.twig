{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{ asset('style.css') }}" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row min-vh-100">

            <aside class="col-md-2 bg-dark text-white p-4">
                <h1 class="mb-4">Admin</h1>

                <nav class="nav flex-column gap-2">
                    <a class="nav-link text-primary p-0" href="{{ path('admin_media_index') }}">Medias</a>
                    <a class="nav-link text-primary p-0" href="{{ path('admin_album_index') }}">Albums</a>
                    <a class="nav-link text-primary p-0" href="{{ path('admin_guest_index') }}">Invités</a>

                    <hr class="border-light">

                    <a class="nav-link text-light p-0" href="{{ path('home') }}">Retour au site</a>
                    <a class="nav-link text-light p-0" href="{{ path('app_logout') }}">Déconnexion</a>
                </nav>
            </aside>

            <main class="col-md-10 p-4 bg-white">
                {% block admin %}{% endblock %}
            </main>

        </div>
    </div>
{% endblock %}