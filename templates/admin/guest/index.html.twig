{% extends 'admin.html.twig' %}

{% block title %}Gestion des invités{% endblock %}

{% block admin %}

<div class="admin-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des invités</h1>

        <a href="{{ path('admin_guest_new') }}" class="btn btn-primary">
            Ajouter un invité
        </a>
    </div>

    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nom</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for guest in guests %}
                <tr>
                    <td>{{ guest.email }}</td>

                    <td>{{ guest.name }}</td>

                    <td>
                        {% if guest.isActive %}
                            <span class="text-success fw-bold">
                                Actif
                            </span>
                        {% else %}
                            <span class="text-danger fw-bold">
                                Bloqué
                            </span>
                        {% endif %}
                    </td>

                    <td class="d-flex gap-2">

                        <a href="{{ path('admin_guest_toggle', {id: guest.id}) }}"
                           onclick="return confirm('Confirmer cette action ?')"
                           class="btn btn-sm {{ guest.isActive ? 'btn-danger' : 'btn-success' }}">

                            {{ guest.isActive ? 'Bloquer' : 'Débloquer' }}

                        </a>

                        <form method="post"
                              action="{{ path('admin_guest_delete', {id: guest.id}) }}"
                              onsubmit="return confirm('Voulez-vous vraiment supprimer cet invité et ses médias ?')">

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('delete_guest_' ~ guest.id) }}">

                            <button type="submit" class="btn btn-secondary btn-sm">
                                Supprimer
                            </button>

                        </form>

                    </td>
                </tr>

            {% else %}

                <tr>
                    <td colspan="4" class="text-center">
                        Aucun invité
                    </td>
                </tr>

            {% endfor %}
        </tbody>
    </table>

</div>

{% endblock %}