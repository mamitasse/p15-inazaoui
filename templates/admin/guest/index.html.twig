{% extends 'base.html.twig' %}

{% block title %}Gestion des invités{% endblock %}

{% block body %}

<div style="padding: 20px;">

    <h1>Liste des invités</h1>

    <a href="{{ path('admin_guest_new') }}"
       style="display: inline-block; margin-bottom: 15px; padding: 8px 15px;
              background-color: #007bff; color: white; text-decoration: none; border-radius: 5px;">
        ➕ Ajouter un invité
    </a>

    <table border="1" cellpadding="10" style="border-collapse: collapse; width: 100%;">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nom</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {% for guest in guests %}
                <tr>
                    <td>{{ guest.email }}</td>
                    <td>{{ guest.name }}</td>

                    <td>
                        {% if guest.isActive %}
                            <span style="color: green; font-weight: bold;">Actif</span>
                        {% else %}
                            <span style="color: red; font-weight: bold;">Bloqué</span>
                        {% endif %}
                    </td>

                    <td>
                        <a href="{{ path('admin_guest_toggle', {id: guest.id}) }}"
                           onclick="return confirm('Confirmer cette action ?')"
                           style="padding: 5px 10px; text-decoration: none; border-radius: 5px;
                            background-color: {{ guest.isActive ? '#dc3545' : '#28a745' }};
                            color: white; display: inline-block;">
                            {{ guest.isActive ? 'Bloquer' : 'Débloquer' }}
                        </a>

                        <form method="post"
                              action="{{ path('admin_guest_delete', {id: guest.id}) }}"
                              style="display:inline;"
                              onsubmit="return confirm('Voulez-vous vraiment supprimer cet invité et ses médias ?')">

                            <input type="hidden" name="_token" value="{{ csrf_token('delete_guest_' ~ guest.id) }}">

                            <button type="submit"
                                    style="padding: 5px 10px; border: none; border-radius: 5px;
       background-color: #6c757d; color: white; margin-left: 8px;">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" style="text-align: center;">Aucun invité</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</div>

{% endblock %}