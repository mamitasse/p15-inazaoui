{% extends 'front.html.twig' %}

{% block front %}

<div class="row">

    <div class="col-12">

        <div class="d-flex justify-content-between align-items-center mb-5">

            <h2>{{ guest.name }}</h2>

            <a href="{{ path('guests') }}">
                Retour aux invités
            </a>

        </div>

        <div class="row">

            {% for media in guest.medias %}

                <div class="col-md-4 mb-4">

                    <div class="card h-100">

                        <img
                            src="{{ asset('uploads/' ~ media.path) }}"
                            class="card-img-top"
                            alt="{{ media.title }}"
                        >

                        <div class="card-body">

                            <h5 class="card-title">
                                {{ media.title }}
                            </h5>

                        </div>

                    </div>

                </div>

            {% else %}

                <div class="col-12">

                    <p>
                        Aucun média disponible pour cet invité.
                    </p>

                </div>

            {% endfor %}

        </div>

    </div>

</div>

{% endblock %}